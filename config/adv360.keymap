/*
 * Erik's adv360.keymap file based on Kinesis repo / starter config file
 * edited using https://nickcoutsos.github.io/keymap-editor/
 */

#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp N1     &kp N2         &kp N3    &kp N4     &kp N5  &mo 1                                                                                  &mo 3        &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp ESC     &kp Q      &kp W          &kp E     &kp R      &kp T   &macro_date                                                                            &macro_date  &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp DELETE  &kp A      &kp S          &kp D     &kp F      &kp G   &macro_paste            &kp LWIN  &kp LEFT_CONTROL    &kp LGUI   &kp RALT              &macro_copy  &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z      &kp X          &kp C     &kp V      &kp B                                     &kp PAGE_UP         &kp PG_UP                                     &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2       &kp GRAVE  &kp LC(SPACE)  &kp LEFT  &kp RIGHT                        &kp BSPC  &kp TAB   &kp PAGE_DOWN       &kp PG_DN  &kp ENTER  &kp SPACE                       &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        layer_keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &kp K_CALCULATOR  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans            &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans  &trans          &trans  &trans            &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &trans    &trans                          &trans            &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans    &trans  &trans  &trans                            &trans      &trans        &kp KP_DOT     &trans           &trans
            >;
        };

        layer_fn {
            display-name = "Fn";
            bindings = <
&kp F1       &kp F2          &kp F3          &kp F4          &kp F5           &kp F6          &trans                                                                      &trans          &kp F7          &kp F8          &kp F9          &kp F10          &kp F11          &kp F12
&macro_lock  &macro_lock     &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans          &msc SCRL_UP                                                                &msc SCRL_UP    &none           &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans           &macro_lock
&kp C_POWER  &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans          &msc SCRL_DOWN          &trans  &trans      &trans    &trans                &msc SCRL_DOWN  &none           &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans           &kp C_POWER
&trans       &kp LG(RS(F1))  &kp LG(LS(F2))  &kp LG(LS(F3))  &kp LG(LS(F4))   &kp LG(LS(F5))                                  &kp HOME    &kp HOME                                        &kp LG(LS(F6))  &kp LS(LG(F7))  &kp LS(LG(F8))  &kp LG(LS(F9))   &kp LG(LS(F10))  &trans
&trans       &trans          &trans          &trans          &trans                                           &trans  &trans  &kp END     &kp END   &kp KP_ENTER  &trans                                  &trans          &trans          &trans           &trans           &trans
            >;
        };

        layer_mod {
            display-name = "Mod";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                        &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                                                  &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none               &none  &none    &bt BT_CLR  &none                        &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                                    &none    &none                                                            &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                                    &none  &none  &none    &none       &bl BL_TOG  &rgb_ug RGB_TOG                                 &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};

/ {
    macros {
        macro_paste: macro_paste {
            compatible = "zmk,behavior-macro";
            label = "macro_paste";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;
        };

        macro_copy: macro_copy {
            compatible = "zmk,behavior-macro";
            label = "macro_copy";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;
        };

        macro_grave: macro_grave {
            compatible = "zmk,behavior-macro";
            label = "macro_grave";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp LEFT>;
        };

        macro_date: macro_date {
            compatible = "zmk,behavior-macro";
            label = "macro_date";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_2 &kp NUMBER_0 &kp NUMBER_2 &kp NUMBER_6 &kp MINUS &kp LEFT_ARROW>;
        };

        macro_lock: macro_lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_COMMAND &kt LEFT_CONTROL &kp Q &kt LEFT_COMMAND &kt LEFT_CONTROL>;
            label = "MACRO_LOCK";
        };
    };
};

